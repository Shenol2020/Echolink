# The publicly reachable URL of this server (no trailing slash).
# Local dev:   http://localhost:3000
# Azure prod:  https://your-app-name.azurewebsites.net
PUBLIC_URL=http://localhost:3000

# Port the HTTP/WS server listens on.
PORT=3000

# Azure Cache for Redis connection string.
# Format: rediss://:YOUR_ACCESS_KEY@YOUR_HOSTNAME.redis.cache.windows.net:6380
# Leave blank to run without Redis (single-instance / local dev mode).
REDIS_URL=

# Operator security password to access /dashboard and /control consoles.
# Required: Server will refuse to boot without this set.
OPERATOR_PASSWORD= pass

# Permanent secret key used for HMAC-SHA256 signing of session tokens.
# Required: Must be a permanent strong secret (min 32 characters).
SESSION_SECRET=

# Redis TLS verification (true enforces certificate check; false allows self-signed dev certs).
REDIS_TLS_REJECT_UNAUTHORIZED=true
