# Copy this file to .env and fill in your values before running locally or deploying.

# The publicly reachable URL of this server (no trailing slash).
# Local dev:   http://localhost:3000
# Azure prod:  https://your-app-name.azurewebsites.net
PUBLIC_URL=http://localhost:3000

# Port the HTTP/WS server listens on.
# Azure App Service injects this automatically — don't set it in Azure App Settings.
PORT=3000

# Azure Cache for Redis connection string.
# Format: rediss://:YOUR_ACCESS_KEY@YOUR_HOSTNAME.redis.cache.windows.net:6380
# Leave blank to run without Redis (single-instance / local dev mode).
REDIS_URL=
